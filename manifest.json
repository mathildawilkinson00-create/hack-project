{
  "manifest_version": 3,
  "name": "Gesture Presenter",
  "version": "0.1.0",
  "description": "Control your Figma presentation with hand gestures (MediaPipe, runs 100% on your device).",
  "action": { "default_title": "Open Gesture Presenter" },
  "background": { "service_worker": "bridge/background.js" },
  "permissions": ["storage", "tabs", "debugger"],
  "host_permissions": ["https://www.figma.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.figma.com/*"],
      "js": ["bridge/content.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
